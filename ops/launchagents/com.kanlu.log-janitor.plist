<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kanlu.log-janitor</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/kan.lu/bin/log-janitor.sh</string>
    </array>

    <!-- 每小时的第 23 分：避开整点，别和其它任务挤在同一秒 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Minute</key>
        <integer>23</integer>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/log-janitor-launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/log-janitor-launchd.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/kan.lu</string>
        <key>TZ</key>
        <string>Asia/Singapore</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
