# Defaults used by the install scripts and launchers.
SESSION_ROOT="$HOME/claude-sessions"
VSCODE_SETTINGS="$HOME/Library/Application Support/Code/User/settings.json"
VIBEPROXY_BASE_URL="http://localhost:8317"
VIBEPROXY_API_KEY="vibeproxy"
VIBEPROXY_DEFAULT_MODEL="gpt-5.5"
VIBEPROXY_DEFAULT_EFFORT="max"
HAPPY_SERVER_URL="${HAPPY_SERVER_URL:-http://localhost:3005}"
