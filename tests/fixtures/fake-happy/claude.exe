// Fake claude.exe.
//  - If the terminal is still in raw mode left by a killed predecessor, it
//    exits at once, printing what the real one prints. This is the
//    2026-10-23 "Support" failure.
//  - Puts the terminal in raw mode and does not restore it when killed.
//  - With $HOME/busy-flag present it runs a tool command (zsh -c) like the Bash tool.
const { execSync, spawn } = require('node:child_process');
const fs = require('node:fs');
const path = require('node:path');
let mode = '';
try { mode = execSync('stty -a', { stdio: ['inherit', 'pipe', 'ignore'] }).toString(); } catch {}
if (/-icrnl/.test(mode) && /-isig/.test(mode)) {
  console.log('Resume this session with:\nclaude --resume x');
  process.exit(0);
}
try { execSync('stty raw -echo -icrnl -isig', { stdio: 'inherit' }); } catch {}
if (fs.existsSync(path.join(process.env.HOME, 'busy-flag'))) {
  // Compound command, like the Bash tool's `source ... && eval ...`; a single
  // command would make zsh exec it and the `zsh -c` process would vanish.
  spawn('/bin/zsh', ['-c', 'sleep 600; true'], { stdio: 'ignore' });
}
process.on('SIGTERM', () => process.exit(143));
setInterval(() => {}, 1000);
