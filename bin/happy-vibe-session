#!/bin/bash
# Start a Happy Coder tmux session through VibeProxy/Codex.

set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
[ -f "$REPO_DIR/config/defaults.env" ] && source "$REPO_DIR/config/defaults.env"
source "$REPO_DIR/lib/session.sh"

MODEL="${VIBEPROXY_DEFAULT_MODEL:-gpt-5.5}"
EFFORT="${VIBEPROXY_DEFAULT_EFFORT:-max}"
VIBEPROXY_BASE_URL="${VIBEPROXY_BASE_URL:-http://localhost:8317}"
VIBEPROXY_API_KEY="${VIBEPROXY_API_KEY:-vibeproxy}"
VSCODE_SETTINGS="${VSCODE_SETTINGS:-$HOME/Library/Application Support/Code/User/settings.json}"
RESTART="false"

usage() {
  cat <<'EOF'
Usage: happy-vibe-session [--restart] [--model MODEL] [--effort LEVEL] <task-name> [session-id]

Examples:
  happy-vibe-session GCP
  happy-vibe-session --restart GCP 5432a2e4-fc63-44de-86c5-7c9d318c7829
  happy-vibe-session --model gpt-5.4 --effort high GCP

Defaults:
  model:  gpt-5.5
  effort: max
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --restart)
      RESTART="true"
      shift
      ;;
    --model)
      [ "$#" -ge 2 ] || { echo "Missing value for --model" >&2; exit 2; }
      MODEL="$2"
      shift 2
      ;;
    --effort)
      [ "$#" -ge 2 ] || { echo "Missing value for --effort" >&2; exit 2; }
      case "$2" in
        low|medium|high|max) EFFORT="$2" ;;
        *) echo "Invalid --effort value: $2" >&2; echo "Allowed values: low, medium, high, max" >&2; exit 2 ;;
      esac
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
    *)
      break
      ;;
  esac
done

SESSION_NAME="${1:-}"
SESSION_ID="${2:-}"

if [ -z "$SESSION_NAME" ]; then
  usage >&2
  exit 2
fi

if ! lsof -i :8317 -sTCP:LISTEN >/dev/null 2>&1; then
  if [ -d /Applications/VibeProxy.app ]; then
    open -a /Applications/VibeProxy.app
    sleep 3
  fi
fi

if ! lsof -i :8317 -sTCP:LISTEN >/dev/null 2>&1; then
  echo "VibeProxy is not running. Launch /Applications/VibeProxy.app first." >&2
  exit 1
fi

if ! curl -fsS --max-time 10 "$VIBEPROXY_BASE_URL/v1/models" | grep -q "\"id\":\"${MODEL}\""; then
  echo "VibeProxy is running, but model '${MODEL}' is not available." >&2
  echo "Available models:" >&2
  curl -fsS --max-time 10 "$VIBEPROXY_BASE_URL/v1/models" \
    | tr '{},' '\n' \
    | sed -n 's/.*"id":"\([^"]*\)".*/  \1/p' >&2
  exit 1
fi

SESSION_DIR="$(session_dir "$SESSION_NAME")"
ensure_session_dir "$SESSION_NAME"

session_process_tree() {
  local root_pid="$1"
  ps axeww -o pid=,ppid=,command= | awk -v root="$root_pid" '
    {
      pid=$1
      ppid=$2
      $1=""
      $2=""
      sub(/^[[:space:]]+/, "", $0)
      parent[pid]=ppid
      command[pid]=$0
    }
    END {
      seen[root]=1
      changed=1
      while (changed) {
        changed=0
        for (pid in parent) {
          if (!seen[pid] && seen[parent[pid]]) {
            seen[pid]=1
            changed=1
          }
        }
      }
      for (pid in seen) {
        print command[pid]
      }
    }
  '
}

session_is_current_vibe() {
  local pane_pid pane_path process_tree option_config
  pane_pid="$(tmux display-message -p -t "$SESSION_NAME" '#{pane_pid}' 2>/dev/null || true)"
  pane_path="$(tmux display-message -p -t "$SESSION_NAME" '#{pane_current_path}' 2>/dev/null || true)"
  [ -n "$pane_pid" ] || return 1
  [ "$pane_path" = "$SESSION_DIR" ] || return 1

  process_tree="$(session_process_tree "$pane_pid")"
  grep -Fq -- "--model=$MODEL" <<<"$process_tree" || return 1
  grep -Fq -- "--effort=$EFFORT" <<<"$process_tree" || return 1

  option_config="$(tmux show-option -qv -t "$SESSION_NAME" @happy_vibe_config_dir 2>/dev/null || true)"
  if [ -n "$option_config" ]; then
    [ "$option_config" = "$CLAUDE_CONFIG_DIR" ] || return 1
  elif grep -Fq "CLAUDE_CONFIG_DIR=" <<<"$process_tree"; then
    grep -Fq "CLAUDE_CONFIG_DIR=$CLAUDE_CONFIG_DIR" <<<"$process_tree" || return 1
  else
    [ "$CLAUDE_CONFIG_DIR" = "$HOME/.claude" ] || return 1
  fi
}

restore_command() {
  local command_parts=() quoted
  if [ "$CLAUDE_CONFIG_DIR" != "$HOME/.claude" ]; then
    command_parts+=("CLAUDE_CONFIG_DIR=$CLAUDE_CONFIG_DIR")
  fi
  command_parts+=("$SCRIPT_DIR/happy-vibe-session" "$SESSION_NAME")
  if [ -n "$RESOLVED_SESSION_ID" ]; then
    command_parts+=("$RESOLVED_SESSION_ID")
  fi
  printf -v quoted '%q ' "${command_parts[@]}"
  printf '%s' "${quoted% }"
}

register_vscode_restore() {
  python3 "$REPO_DIR/lib/vscode_restore.py" register-command "$VSCODE_SETTINGS" "$SESSION_NAME" "$(restore_command)"
}

RESOLVED_SESSION_ID="$(resolve_session_id "$SESSION_NAME" "$SESSION_ID")"

if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
  if [ "$RESTART" = "true" ]; then
    tmux kill-session -t "$SESSION_NAME"
  elif session_is_current_vibe; then
    register_vscode_restore
    attach_or_switch "$SESSION_NAME"
  else
    echo "tmux session '$SESSION_NAME' exists but was not launched with the current VibeProxy settings; recreating it." >&2
    tmux kill-session -t "$SESSION_NAME"
  fi
fi

ENV_PREFIX="$(session_base_env_prefix)$(printf '%q ' \
  HAPPY_SERVER_URL="${HAPPY_SERVER_URL:-http://localhost:3005}" \
  CLAUDE_CONFIG_DIR="$CLAUDE_CONFIG_DIR" \
  ANTHROPIC_BASE_URL="$VIBEPROXY_BASE_URL" \
  ANTHROPIC_AUTH_TOKEN="$VIBEPROXY_API_KEY" \
  ANTHROPIC_API_KEY="" \
  DISABLE_TELEMETRY="true" \
  DISABLE_COST_WARNINGS="true" \
  API_TIMEOUT_MS="600000")"

MODEL_ARG="--model=$MODEL"
EFFORT_ARG="--effort=$EFFORT"

if [ -n "$RESOLVED_SESSION_ID" ]; then
  HAPPY_CMD="${ENV_PREFIX}$(printf '%q ' happy --yolo "$MODEL_ARG" "$EFFORT_ARG" --resume "$RESOLVED_SESSION_ID")"
else
  HAPPY_CMD="${ENV_PREFIX}$(printf '%q ' happy --yolo "$MODEL_ARG" "$EFFORT_ARG" --continue)"
fi

if ! tmux new-session -d -s "$SESSION_NAME" -c "$SESSION_DIR"; then
  echo "Error: failed to create tmux session '$SESSION_NAME'" >&2
  exit 1
fi

tmux send-keys -t "$SESSION_NAME" "$HAPPY_CMD" Enter
tmux set-option -q -t "$SESSION_NAME" @happy_vibe_config_dir "$CLAUDE_CONFIG_DIR"
tmux set-option -q -t "$SESSION_NAME" @happy_vibe_model "$MODEL"
tmux set-option -q -t "$SESSION_NAME" @happy_vibe_effort "$EFFORT"
register_vscode_restore
echo "New VibeProxy Happy session: $SESSION_NAME"
echo "Model: $MODEL"
echo "Effort: $EFFORT"

emit_vscode_cwd "$SESSION_DIR"
attach_or_switch "$SESSION_NAME"
