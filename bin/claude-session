#!/bin/bash
# Usage: claude-session "task name" [session-id]
# Set CLAUDE_LAUNCHER=happy to use Happy Coder instead of claude.

set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
[ -f "$REPO_DIR/config/defaults.env" ] && source "$REPO_DIR/config/defaults.env"
source "$REPO_DIR/lib/session.sh"

SESSION_NAME="${1:-}"
SESSION_ID="${2:-}"
LAUNCHER="${CLAUDE_LAUNCHER:-claude}"
VSCODE_SETTINGS="${VSCODE_SETTINGS:-$HOME/Library/Application Support/Code/User/settings.json}"

if [ -z "$SESSION_NAME" ]; then
  echo "Usage: claude-session <task-name> [session-id]"
  echo ""
  echo "Running sessions:"
  print_running_sessions
  exit 1
fi

echo -ne "\033]0;${SESSION_NAME}\007"

if ! tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
  SESSION_DIR="$(session_dir "$SESSION_NAME")"
  ensure_session_dir "$SESSION_NAME"
  RESOLVED_SESSION_ID="$(resolve_session_id "$SESSION_NAME" "$SESSION_ID")"

  if [ "$LAUNCHER" = "happy" ] && [ -n "$RESOLVED_SESSION_ID" ]; then
    SESSION_CMD=$(printf '%q ' happy --yolo --resume "$RESOLVED_SESSION_ID")
    RESTORE_CMD="happy-session"
  elif [ "$LAUNCHER" = "happy" ]; then
    SESSION_CMD=$(printf '%q ' happy --yolo --continue)
    RESTORE_CMD="happy-session"
  elif [ -n "$RESOLVED_SESSION_ID" ]; then
    SESSION_CMD=$(printf '%q ' claude --dangerously-skip-permissions --resume "$RESOLVED_SESSION_ID")
    RESTORE_CMD="claude-session"
  else
    SESSION_CMD=$(printf '%q ' claude --dangerously-skip-permissions --continue)
    RESTORE_CMD="claude-session"
  fi

  if ! tmux new-session -d -s "$SESSION_NAME" -c "$SESSION_DIR" "$SESSION_CMD"; then
    echo "Error: failed to create tmux session '$SESSION_NAME'" >&2
    exit 1
  fi

  python3 "$REPO_DIR/lib/vscode_restore.py" register "$VSCODE_SETTINGS" "$SESSION_NAME" "$RESTORE_CMD" "$RESOLVED_SESSION_ID"
  echo "New session: $SESSION_NAME"
else
  echo "Restored session: $SESSION_NAME"
fi

SESSION_DIR="$(session_dir "$SESSION_NAME")"
emit_vscode_cwd "$SESSION_DIR"
attach_or_switch "$SESSION_NAME"
