#!/bin/bash
# Usage: claude-session "task name" [session-id]
# Set CLAUDE_LAUNCHER=happy to use Happy Coder instead of claude.

set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
[ -f "$REPO_DIR/config/defaults.env" ] && source "$REPO_DIR/config/defaults.env"
source "$REPO_DIR/lib/session.sh"

SESSION_NAME="${1:-}"
SESSION_ID="${2:-}"
LAUNCHER="${CLAUDE_LAUNCHER:-claude}"
VSCODE_SETTINGS="${VSCODE_SETTINGS:-$HOME/Library/Application Support/Code/User/settings.json}"

if [ -z "$SESSION_NAME" ]; then
  echo "Usage: claude-session <task-name> [session-id]"
  echo ""
  echo "Running sessions:"
  print_running_sessions
  exit 1
fi

echo -ne "\033]0;${SESSION_NAME} 💤\007"

# Fail-loud guard: a "Personal" session MUST run under ~/.claude-private, else
# its transcript lands in ~/.claude/projects which the Claudecraft agent scans
# and uploads. A wrong alias would leak it irreversibly, so refuse to launch.
enforce_personal_private_config() {
  if [ "$SESSION_NAME" = "Personal" ] && [ "$CLAUDE_CONFIG_DIR" != "$HOME/.claude-private" ]; then
    echo "Error: 'Personal' session requires CLAUDE_CONFIG_DIR=$HOME/.claude-private (got: $CLAUDE_CONFIG_DIR)" >&2
    echo "       Use: happy-session-private \"Personal\"" >&2
    exit 1
  fi
  if [ "$SESSION_NAME" = "Personal" ]; then
    CLAUDE_CONFIG_DIR="$CLAUDE_CONFIG_DIR" SESSION_ROOT="$SESSION_ROOT" \
      python3 "$REPO_DIR/lib/personal_history.py" --check
  fi
}

personal_launch_command() {
  local parts=(python3 "$REPO_DIR/lib/personal_history.py" --launch "$LAUNCHER")
  if [ -n "$SESSION_ID" ]; then
    parts+=("$SESSION_ID")
  fi
  printf '%s' "$(session_env_prefix)"
  printf '%q ' "SESSION_ROOT=$SESSION_ROOT" "${parts[@]}"
}

sync_personal_private_auth() {
  if [ "$SESSION_NAME" = "Personal" ] && [ "$CLAUDE_CONFIG_DIR" = "$HOME/.claude-private" ]; then
    "$SCRIPT_DIR/claude-auth-sync" --private-config "$CLAUDE_CONFIG_DIR" || {
      echo "Warning: Claude auth sync failed for Personal; continuing with existing private auth" >&2
    }
  fi
}

restore_launcher() {
  local command_parts=() quoted

  if [ "$CLAUDE_CONFIG_DIR" = "$HOME/.claude" ]; then
    if [ "$LAUNCHER" = "happy" ]; then
      printf '%s' "happy-session"
      return
    fi

    printf '%s' "claude-session"
    return
  fi

  if [ "$LAUNCHER" = "happy" ]; then
    command_parts+=("CLAUDE_LAUNCHER=happy")
  fi
  command_parts+=("CLAUDE_CONFIG_DIR=$CLAUDE_CONFIG_DIR")

  command_parts+=("$SCRIPT_DIR/claude-session")
  printf -v quoted '%q ' "${command_parts[@]}"
  printf '%s' "${quoted% }"
}

session_env_prefix() {
  local prefix

  prefix="$(session_base_env_prefix)"
  if [ "$CLAUDE_CONFIG_DIR" != "$HOME/.claude" ]; then
    prefix+="$(printf '%q ' "CLAUDE_CONFIG_DIR=$CLAUDE_CONFIG_DIR")"
  fi

  printf '%s' "$prefix"
}

is_current_invocation_process() {
  local candidate="$1"
  local pid="$$"
  local parent

  while [ -n "$pid" ] && [ "$pid" -gt 1 ]; do
    [ "$pid" = "$candidate" ] && return 0
    parent="$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')"
    if [ -z "$parent" ] || [ "$parent" = "$pid" ]; then
      break
    fi
    pid="$parent"
  done

  return 1
}

pane_has_other_child() {
  local pane_pid="$1"
  local pid ppid

  while read -r pid ppid; do
    [ "$ppid" = "$pane_pid" ] || continue
    if ! is_current_invocation_process "$pid"; then
      return 0
    fi
  done < <(ps -eo pid=,ppid=)

  return 1
}

enforce_personal_private_config
sync_personal_private_auth

# happy sessions are started and relaunched by sessionctl (respawn-pane, no
# typing into the pane). The only exception is Personal with an explicit
# conversation id, which personal_history.py has to select itself.
USE_SESSIONCTL=0
if [ "$LAUNCHER" = "happy" ] && { [ "$SESSION_NAME" != "Personal" ] || [ -z "$SESSION_ID" ]; }; then
  USE_SESSIONCTL=1
fi
# `=name` targets match exactly; plain names prefix-match ("Product" -> "Product priorities").
TARGET="=$SESSION_NAME:"

# Replace the pane's idle shell with CMD. From inside that pane, run it in place.
relaunch_in_pane() {
  local cmd="$1"
  if [ -n "${TMUX_PANE:-}" ] && [ "$TMUX_PANE" = "$(tmux display-message -p -t "$TARGET" '#{pane_id}' 2>/dev/null)" ]; then
    stty sane 2>/dev/null || true
    exec /bin/bash -c "$cmd"
  fi
  tmux respawn-pane -k -t "$TARGET" -c "$(session_dir "$SESSION_NAME")" "stty sane 2>/dev/null; $cmd; exec /bin/zsh -l"
}

# sessionctl (and sessionlib, the marker hook) know two config roots: ~/.claude-private
# for Personal, ~/.claude for everything else. Refuse instead of silently ignoring another.
if [ "$USE_SESSIONCTL" = 1 ] && [ "$SESSION_NAME" != "Personal" ] \
   && [ -n "${CLAUDE_CONFIG_DIR:-}" ] && [ "$CLAUDE_CONFIG_DIR" != "$HOME/.claude" ]; then
  echo "Error: happy sessions other than Personal run under ~/.claude (got CLAUDE_CONFIG_DIR=$CLAUDE_CONFIG_DIR)" >&2
  exit 1
fi

# An explicit conversation id for a happy session is the user's choice: record it
# so smart-resume resumes it (the SessionStart hook keeps it current afterwards).
# Not while the session is running: that would fight the live conversation.
if [ "$USE_SESSIONCTL" = 1 ] && [ -n "$SESSION_ID" ]; then
  running_pane="$(tmux list-panes -t "$TARGET" -F '#{pane_pid}' 2>/dev/null | head -1)"
  if [ -n "$running_pane" ] && pane_has_other_child "$running_pane"; then
    echo "Warning: $SESSION_NAME is running; not switching it to $SESSION_ID. Stop it first: sessionctl stop '$SESSION_NAME'" >&2
  else
    python3 "$REPO_DIR/lib/sessionlib.py" write-marker "$SESSION_NAME" "$SESSION_ID" \
      || echo "Warning: session '$SESSION_ID' not found for $SESSION_NAME - resuming the current one" >&2
  fi
fi

if ! tmux has-session -t "=$SESSION_NAME" 2>/dev/null; then
  SESSION_DIR="$(session_dir "$SESSION_NAME")"
  ensure_session_dir "$SESSION_NAME"
  RESOLVED_SESSION_ID="$(resolve_session_id "$SESSION_NAME" "$SESSION_ID")"
  ENV_PREFIX="$(session_env_prefix)"
  RESTORE_CMD="$(restore_launcher)"

  if [ "$USE_SESSIONCTL" = 1 ]; then
    "$SCRIPT_DIR/sessionctl" start "$SESSION_NAME" --no-wait || exit 1
  else
    if [ "$SESSION_NAME" = "Personal" ]; then
      SESSION_CMD="$(personal_launch_command)"
    elif [ -n "$RESOLVED_SESSION_ID" ]; then
      SESSION_CMD="${ENV_PREFIX}$(printf '%q ' claude --dangerously-skip-permissions --resume "$RESOLVED_SESSION_ID")"
    else
      SESSION_CMD="${ENV_PREFIX}$(printf '%q ' claude --dangerously-skip-permissions --continue)"
    fi
    # 命令退出（Ctrl-C 退 Claude）后回落到交互 shell，保住 tmux 窗口——否则窗口即
    # session 一起消失，otty tab 也会被连带关闭。
    if ! tmux new-session -d -s "$SESSION_NAME" -n "${SESSION_NAME} 💤" -c "$SESSION_DIR" "$SESSION_CMD; exec /bin/zsh -l"; then
      echo "Error: failed to create tmux session '$SESSION_NAME'" >&2
      exit 1
    fi
  fi

  RESTORE_SESSION_ID="$RESOLVED_SESSION_ID"
  if [ "$SESSION_NAME" = "Personal" ]; then
    # Default restores reselect the latest conversation, not today's snapshot.
    RESTORE_SESSION_ID="$SESSION_ID"
  fi
  python3 "$REPO_DIR/lib/vscode_restore.py" register "$VSCODE_SETTINGS" "$SESSION_NAME" "$RESTORE_CMD" "$RESTORE_SESSION_ID"
  echo "New session: $SESSION_NAME"
else
  echo "Restored session: $SESSION_NAME"
  # 窗口可能已回落到 fallback shell（happy/claude 退出后 exec zsh 保住了 tab）。
  # 此时只 attach 会进到一个空壳 shell——若 pane 无子进程，先重新拉起。
  # 用 ps 查真实 ppid 列表（pgrep -P 在沙箱中会漏掉其他 pane 的子进程），
  # 并忽略本次调用自身的进程链（从目标 pane 的 fallback shell 执行时）。
  PANE_PID="$(tmux list-panes -t "$TARGET" -F '#{pane_pid}' 2>/dev/null | head -1)"
  if [ -n "$PANE_PID" ] && ! pane_has_other_child "$PANE_PID"; then
    echo "Relaunching agent in idle pane: $SESSION_NAME"
    if [ "$USE_SESSIONCTL" = 1 ]; then
      if [ -n "${TMUX_PANE:-}" ] && [ "$TMUX_PANE" = "$(tmux display-message -p -t "$TARGET" '#{pane_id}' 2>/dev/null)" ]; then
        # Running inside that very pane: respawn-pane would kill this shell, so start in place.
        stty sane 2>/dev/null || true
        exec /bin/bash "$SCRIPT_DIR/smart-resume.sh" "$SESSION_NAME"
      fi
      "$SCRIPT_DIR/sessionctl" start "$SESSION_NAME" --no-wait || exit 1
    elif [ "$SESSION_NAME" = "Personal" ]; then
      relaunch_in_pane "$(personal_launch_command)"
    else
      RESOLVED_SESSION_ID="$(resolve_session_id "$SESSION_NAME" "$SESSION_ID")"
      if [ -n "$RESOLVED_SESSION_ID" ]; then
        relaunch_in_pane "$(session_env_prefix)$(printf '%q ' claude --dangerously-skip-permissions --resume "$RESOLVED_SESSION_ID")"
      else
        relaunch_in_pane "$(session_env_prefix)$(printf '%q ' claude --dangerously-skip-permissions --continue)"
      fi
    fi
  fi
fi

SESSION_DIR="$(session_dir "$SESSION_NAME")"
emit_vscode_cwd "$SESSION_DIR"
attach_or_switch "$SESSION_NAME"
