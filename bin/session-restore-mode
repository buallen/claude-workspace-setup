#!/bin/bash
# Inspect or switch VS Code Restore Terminals commands.

set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
[ -f "$REPO_DIR/config/defaults.env" ] && source "$REPO_DIR/config/defaults.env"

VSCODE_SETTINGS="${VSCODE_SETTINGS:-$HOME/Library/Application Support/Code/User/settings.json}"

usage() {
  cat <<'EOF'
Usage: session-restore-mode list
       session-restore-mode happy
       session-restore-mode vibe

Commands:
  list   Show saved VS Code restore commands.
  happy  Switch saved happy-vibe-session restore commands back to happy-session.
  vibe   Switch saved happy-session restore commands to happy-vibe-session --restart.
EOF
}

case "${1:-}" in
  list)
    python3 "$REPO_DIR/lib/vscode_restore.py" list "$VSCODE_SETTINGS"
    ;;
  happy|vibe)
    python3 "$REPO_DIR/lib/vscode_restore.py" switch "$VSCODE_SETTINGS" "$1"
    ;;
  -h|--help|"")
    usage
    ;;
  *)
    echo "Unknown command: $1" >&2
    usage >&2
    exit 2
    ;;
esac
