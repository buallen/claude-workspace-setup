#!/usr/bin/env python3
"""sessionctl - one way to inspect, start, stop and restart workspace sessions.

  sessionctl status [NAME] [--json]     state, conversation and processes
  sessionctl start NAME [--no-wait]     start the agent in the session's pane (no-op if running)
  sessionctl stop NAME [--force]        stop happy + claude cleanly, leave the pane at a shell
  sessionctl restart NAME [--force]     stop + start under one lock
  sessionctl idle [--hours N] [--json]  sessions idle (or waiting for input) for N+ hours
  sessionctl lock NAME -- CMD...        run CMD holding NAME's lock (75 if taken)

Exit codes: 0 ok, 1 error, 2 usage / no such session, 3 busy (use --force),
4 process identity changed under us, 5 a process would not stop, 75 locked.

Why this exists (2026-10-23): five scripts each had their own way to start a
session, three ways to tell whether one was alive, and all of them typed the
launch command into the pane with `tmux send-keys ... Enter`. That breaks when
a killed Claude leaves the terminal in raw mode, and can type into a live
conversation. sessionctl starts the agent with `tmux respawn-pane`, never by
typing, and stops it in the order happy actually needs (see stop()).
"""
import argparse
from contextlib import contextmanager
import fcntl
import glob
import json
import os
from pathlib import Path
import shlex
import shutil
import signal
import subprocess
import sys
import time

BIN_DIR = Path(os.path.realpath(__file__)).parent
sys.path.insert(0, str(BIN_DIR.parent / "lib"))
import sessionlib as sl  # noqa: E402

LOCK_DIR = sl.HOME / ".claude" / "session-locks"
LOG_FILE = sl.HOME / "Library" / "Logs" / "sessionctl.log"
SMART_RESUME = BIN_DIR / "smart-resume.sh"

OK, ERROR, USAGE, BUSY, IDENTITY, STUCK, LOCKED = 0, 1, 2, 3, 4, 5, 75

HAPPY_EXIT_WAIT = 15     # happy's cleanup does a ~3 s HTTP call plus a flush
CLAUDE_GRACE = 5         # claude often exits by itself once happy is gone
CLAUDE_EXIT_WAIT = 10
KILL_WAIT = 5
SHELL_WAIT = 10
START_WAIT = 45


def log(message):
    line = f"{time.strftime('%Y-%m-%d %H:%M:%S')} {message}"
    print(message)
    try:
        LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
        with LOG_FILE.open("a") as stream:
            stream.write(line + "\n")
    except OSError:
        pass


class Locked(Exception):
    pass


@contextmanager
def session_lock(name):
    """One lock per session, shared by start/stop/restart and every caller."""
    LOCK_DIR.mkdir(parents=True, exist_ok=True)
    handle = open(LOCK_DIR / f"{name}.lock", "w")
    try:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise Locked(name)
        yield
    finally:
        handle.close()


def wait_gone(pid, seconds):
    deadline = time.time() + seconds
    while time.time() < deadline:
        if not sl.alive(pid):
            return True
        time.sleep(0.5)
    return not sl.alive(pid)


def signal_same(ident, sig):
    """Send sig only if pid still names the process we recorded."""
    if ident is None or sl.identity(ident[0]) != ident:
        return False
    try:
        os.kill(ident[0], sig)
    except ProcessLookupError:
        return False
    return True


def terminate(ident, wait, label):
    """SIGTERM, wait, then SIGKILL. Returns OK, IDENTITY or STUCK."""
    pid = ident[0]
    if not sl.alive(pid):
        return OK
    if not signal_same(ident, signal.SIGTERM):
        if not sl.alive(pid):
            return OK
        log(f"  {label} {pid}: identity changed, not touching it")
        return IDENTITY
    if wait_gone(pid, wait):
        return OK
    log(f"  {label} {pid}: ignored SIGTERM for {wait}s, sending SIGKILL")
    signal_same(ident, signal.SIGKILL)
    return OK if wait_gone(pid, KILL_WAIT) else STUCK


def happy_bin_dir():
    found = shutil.which("happy")
    if found:
        return str(Path(found).parent)
    candidates = sorted(glob.glob(str(sl.HOME / ".nvm/versions/node/*/bin/happy")))
    return str(Path(candidates[-1]).parent) if candidates else ""


def launch_command(name):
    """Shell command for the pane: reset the terminal, run smart-resume, keep a shell."""
    env = ["env", "-u", "NO_COLOR", "COLORTERM=truecolor"]
    bin_dir = happy_bin_dir()
    if bin_dir:
        env.append(f"PATH={bin_dir}:{os.environ.get('PATH', '/usr/bin:/bin')}")
    if name in sl.PRIVATE_SESSIONS:
        env.append(f"CLAUDE_CONFIG_DIR={sl.config_dir(name)}")
    # A Claude that was killed leaves the pty in raw mode (-icrnl -isig); a new
    # Claude that inherits it exits immediately. stty sane first.
    return (f"stty sane 2>/dev/null; "
            f"{shlex.join(env)} bash {shlex.quote(str(SMART_RESUME))} {shlex.quote(name)}; "
            f"exec /bin/zsh -l")


def fix_tty(procs):
    if procs and procs.tty:
        subprocess.run(["stty", "-f", procs.tty, "sane"], capture_output=True)


@contextmanager
def stopping_flag(name):
    """Tell smart-resume this exit is deliberate, so it neither retries nor relaunches.

    smart-resume honours the flag only while the pid in it is alive, so a flag
    left behind by a killed sessionctl cannot disable its retries for good.
    """
    LOCK_DIR.mkdir(parents=True, exist_ok=True)
    flag = LOCK_DIR / f"{name}.stopping"
    flag.write_text(f"{os.getpid()} {int(time.time())}\n")
    try:
        yield
    finally:
        flag.unlink(missing_ok=True)


def stop(name, force=False):
    procs = sl.session_procs(name)
    if procs is None:
        log(f"✗ {name}: no such tmux session")
        return USAGE
    if not procs.happy and not procs.claude and not procs.launcher:
        if procs.smart_resume:
            # Between retries (sleep / get_uuid / fork): end the loop itself.
            with stopping_flag(name):
                for ident in filter(None, (sl.identity(pid) for pid in procs.smart_resume)):
                    rc = terminate(ident, CLAUDE_EXIT_WAIT, "smart-resume")
                    if rc != OK:
                        return rc
                wait_for_shell(name)
        fix_tty(sl.session_procs(name))
        log(f"· {name}: already stopped")
        return OK
    state = sl.session_state(name, procs)
    if state["state"] in ("busy", "background") and not force:
        log(f"✗ {name}: {state['state']} ({'; '.join(state['reasons'])}), not stopping without --force")
        return BUSY

    # Keep the marker on the conversation happy is actually syncing, so the
    # next start resumes it even if the SessionStart hook missed a change.
    uuid, source = sl.live_conversation(name, procs)
    if (uuid and source == "happy" and name not in sl.PRIVATE_SESSIONS
            and sl.read_marker(name) != uuid and sl.valid_conversation(name, uuid)):
        sl.write_marker(name, uuid)
        log(f"  {name}: marker -> {uuid} (from happy)")

    recorded = {
        "happy": [i for i in map(sl.identity, procs.happy) if i],
        "launcher": [i for i in map(sl.identity, procs.launcher) if i],
        "claude": [i for i in map(sl.identity, procs.claude) if i],
        "conversations": [uuid] if uuid else [],
    }
    log(f"→ {name}: stopping happy {procs.happy}, launcher {procs.launcher}, claude {procs.claude} (conversation {uuid or '?'})")
    with stopping_flag(name):
        rc = _stop_processes(name, recorded)
    if rc == OK:
        log(f"✓ {name}: stopped")
    return rc


def wait_for_shell(name):
    deadline = time.time() + SHELL_WAIT
    while time.time() < deadline:
        info = sl.pane(name)
        if info and info["command"] in sl.SHELL_COMMANDS:
            return True
        time.sleep(0.5)
    return False


def _stop_processes(name, recorded):
    # 1. happy first. Its SIGTERM handler marks the session disconnected (not
    #    archived) and exits, but never kills its claude child. Killing claude
    #    first does not work: the launcher would immediately respawn it.
    for ident in recorded["happy"]:
        rc = terminate(ident, HAPPY_EXIT_WAIT, "happy")
        if rc != OK:
            return rc

    # 2. Every launcher, with the claude it is running right now, including one
    #    it started after we looked (e.g. stop called seconds after start).
    #    Launcher before claude: a launcher outliving its claude respawns it.
    for lid in recorded["launcher"]:
        table = sl.process_table()
        children = [sl.identity(pid) for pid, (ppid, command) in table.items()
                    if ppid == lid[0] and sl.CLAUDE_RE.search(sl.program(command))]
        recorded["claude"].extend(i for i in children if i and i not in recorded["claude"])
        rc = terminate(lid, CLAUDE_EXIT_WAIT, "launcher")
        if rc != OK:
            return rc

    # 3. The (now orphaned) claude processes; give each a moment to exit alone.
    for ident in recorded["claude"]:
        if wait_gone(ident[0], CLAUDE_GRACE):
            continue
        rc = terminate(ident, CLAUDE_EXIT_WAIT, "claude")
        if rc != OK:
            return rc

    # 3b. A claude the launcher spawned between our scan and its death is now
    #     reparented to launchd and outside the pane; find it by conversation.
    for uuid in recorded.get("conversations", []):
        table = sl.process_table()
        for pid, (ppid, command) in table.items():
            if ppid == 1 and uuid in command and sl.CLAUDE_RE.search(sl.program(command)):
                ident = sl.identity(pid)
                if ident:
                    recorded["claude"].append(ident)
                    rc = terminate(ident, CLAUDE_EXIT_WAIT, "orphaned claude")
                    if rc != OK:
                        return rc

    # 4. Verify instead of assuming: nothing we recorded is left, and nothing new
    #    took its place in the pane.
    left = [f"{kind} {i[0]}" for kind, ids in recorded.items() if kind != "conversations"
            for i in ids if sl.identity(i[0]) == i]
    procs = sl.session_procs(name)
    if procs and (procs.happy or procs.launcher or procs.claude):
        left.append(f"pane still runs happy {procs.happy} launcher {procs.launcher} claude {procs.claude}")
    if left:
        log(f"✗ {name}: still running after stop: {'; '.join(left)}")
        return STUCK

    # 5. smart-resume ends its loop on the flag and the pane falls back to its
    #    shell; then repair the terminal mode a killed claude left behind.
    wait_for_shell(name)
    fix_tty(sl.session_procs(name))
    return OK


def start(name, wait=True):
    directory = sl.session_dir(name)
    if not directory.is_dir():
        log(f"✗ {name}: {directory} does not exist")
        return USAGE
    command = launch_command(name)
    if name not in sl.list_sessions():
        code, _ = sl.tmux("new-session", "-d", "-s", name, "-n", f"{name} 💤", "-c", str(directory), command)
        if code != 0:
            log(f"✗ {name}: tmux new-session failed")
            return ERROR
        log(f"→ {name}: created tmux session")
    else:
        procs = sl.session_procs(name)
        if procs and (procs.happy or procs.claude):
            log(f"· {name}: already running")
            return OK
        if procs and (procs.smart_resume or procs.launcher):
            log(f"· {name}: already launching")
            return OK
        info = sl.pane(name)
        if info and info["command"] not in sl.SHELL_COMMANDS:
            log(f"✗ {name}: pane is running '{info['command']}', not replacing it")
            return BUSY
        # respawn-pane replaces the idle shell; nothing is typed into the pane.
        code, _ = sl.tmux("respawn-pane", "-k", "-t", sl.target(name), "-c", str(directory), command)
        if code != 0:
            log(f"✗ {name}: tmux respawn-pane failed")
            return ERROR
    if not wait:
        log(f"→ {name}: launched")
        return OK
    deadline = time.time() + START_WAIT
    while time.time() < deadline:
        procs = sl.session_procs(name)
        if procs and procs.happy and procs.claude:
            uuid, source = sl.live_conversation(name, procs)
            log(f"✓ {name}: running (happy {procs.happy[0]}, claude {procs.claude[0]}, conversation {uuid or 'new'})")
            return OK
        time.sleep(1)
    log(f"✗ {name}: agent did not come up within {START_WAIT}s; see `tmux capture-pane -p -t '={name}:'`")
    return ERROR


def status_rows(names):
    table = sl.process_table()
    rows = []
    for name in names:
        procs = sl.session_procs(name, table)
        state = sl.session_state(name, procs)
        uuid, source = sl.live_conversation(name, procs) if procs else (None, None)
        version = None
        if procs and procs.happy:
            command = table.get(procs.happy[0], (0, ""))[1]
            version = "happy-coder" if "happy-coder" in command else "happy"
        idle = state["idle_since"]
        rows.append({
            "name": name, "state": state["state"], "reasons": state["reasons"],
            "idle_hours": round((time.time() - idle) / 3600, 1) if idle else None,
            "conversation": uuid, "conversation_source": source,
            "marker_matches": (sl.read_marker(name) == uuid) if uuid else None,
            "happy_pids": procs.happy if procs else [], "claude_pids": procs.claude if procs else [],
            "package": version,
        })
    return rows


def cmd_status(args):
    names = [args.name] if args.name else sl.list_sessions()
    rows = status_rows(names)
    if args.json:
        print(json.dumps(rows, ensure_ascii=False, indent=1))
        return OK
    for r in rows:
        idle = f"{r['idle_hours']}h" if r["idle_hours"] is not None else "-"
        conv = f"{(r['conversation'] or '-')[:8]}({r['conversation_source'] or '-'})"
        print(f"{r['name']:20} {r['state']:10} idle {idle:>6}  {conv:16} {r['package'] or '-':11} {'; '.join(r['reasons'])}")
    return OK


def cmd_idle(args):
    rows = [r for r in status_rows(sl.list_sessions())
            if r["state"] in ("idle", "waiting") and (r["idle_hours"] or 0) >= args.hours]
    if args.json:
        print(json.dumps(rows, ensure_ascii=False, indent=1))
    else:
        for r in sorted(rows, key=lambda r: -r["idle_hours"]):
            print(f"{r['name']}\t{r['state']}\t{r['idle_hours']}h")
    return OK


def with_lock(name, fn):
    try:
        with session_lock(name):
            return fn()
    except Locked:
        log(f"✗ {name}: another sessionctl is working on it (locked)")
        return LOCKED


def main(argv=None):
    parser = argparse.ArgumentParser(prog="sessionctl", description=__doc__.split("\n\n")[0])
    sub = parser.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("status"); p.add_argument("name", nargs="?"); p.add_argument("--json", action="store_true")
    p = sub.add_parser("idle"); p.add_argument("--hours", type=float, default=24); p.add_argument("--json", action="store_true")
    p = sub.add_parser("lock", help="run a command while holding the session's lock")
    p.add_argument("name"); p.add_argument("command", nargs=argparse.REMAINDER)
    for cmd in ("start", "stop", "restart"):
        p = sub.add_parser(cmd); p.add_argument("name")
        if cmd != "start":
            p.add_argument("--force", action="store_true")
        else:
            p.add_argument("--no-wait", action="store_true", help="return as soon as the pane is launched")
    args = parser.parse_args(argv)

    if args.cmd == "status":
        return cmd_status(args)
    if args.cmd == "idle":
        return cmd_idle(args)
    if args.cmd == "lock":
        command = args.command[1:] if args.command[:1] == ["--"] else args.command
        if not command:
            parser.error("lock needs a command after --")
        return with_lock(args.name, lambda: subprocess.call(command))
    if args.cmd == "start":
        return with_lock(args.name, lambda: start(args.name, wait=not args.no_wait))
    if args.cmd == "stop":
        return with_lock(args.name, lambda: stop(args.name, args.force))
    return with_lock(args.name, lambda: stop(args.name, args.force) or start(args.name))


if __name__ == "__main__":
    sys.exit(main())
